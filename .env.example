# ServeBase Environment Configuration Template
# Duplicate this file to .env and adjust variables as needed.

# Database Connection (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/servebase

# API Server Settings
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# JWT Authentication
JWT_SECRET=servebase-production-secret-key-change-in-production

# Native C++ Pricing & Payroll Engine Path
CORE_BIN_PATH=../core/servebase_core.exe
