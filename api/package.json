{
  "name": "servebase-api",
  "version": "1.0.0",
  "description": "ServeBase POS & Back-Office Core API Server",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "tsx src/server.ts",
    "migrate": "tsx src/db/migrate.ts",
    "db:init": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run --fileParallelism=false"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/websocket": "^10.0.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.5",
    "@types/pg": "^8.11.8",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
